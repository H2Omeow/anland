    <!-- WlSettingsActivity: desktop -->
    <string name="desktop_section">桌面（嵌套合成器）</string>
    <string name="desktop_section_tip">在一个 anland 窗口里跑 KWin、Weston、Sway、Mutter 之类的合成器。会话模式让它在每次 configure 时拿到 FULLSCREEN|MAXIMIZED 并被钉在屏幕尺寸上, 于是它把宿主当成一台显示器。</string>
    <string name="desktop_mode_tip">会话窗口:</string>
    <string name="desktop_mode">把匹配的窗口当作桌面会话（desktop_mode）</string>
    <string name="desktop_match_tip">被当作桌面会话的窗口标题（逗号分隔, 不区分大小写）:</string>
    <string name="desktop_hint">在容器里启动: 先 anland-session.sh, 再 anland-desktop。</string>
