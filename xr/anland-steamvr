#!/usr/bin/env bash
# anland-steamvr - install and run SteamVR against anland's XR window support.
#
#   anland-steamvr install [--system]   copy the driver into SteamVR, register
#                                       the Vulkan layer, enable the driver
#   anland-steamvr uninstall            undo install
#   anland-steamvr status               what the daemon is currently publishing
#   anland-steamvr start [args...]      launch vrstartup with the right env
#   anland-steamvr stop                 ask SteamVR to shut down
#
# Everything is user-local by default (no root): the layer goes into
# ~/.local/share/vulkan/implicit_layer.d and the driver into the SteamVR
# install. --system puts the layer in /usr/share/vulkan/implicit_layer.d.
#
# Run this *inside the container*, as the user that runs Steam.
set -euo pipefail

here=$(cd -- "$(dirname -- "$0")" && pwd)
build=${OUT_DIR:-$here/build}

RT=${ANLAND_RUNTIME_DIR:-/run/anland}
layer_name=VK_LAYER_anland_vr
driver_name=anland

say()  { printf '%s\n' "$*"; }
warn() { printf 'warning: %s\n' "$*" >&2; }
die()  { printf 'error: %s\n' "$*" >&2; exit 1; }

find_steamvr() {
    if [ -n "${STEAMVR:-}" ] && [ -d "$STEAMVR" ]; then printf '%s' "$STEAMVR"; return 0; fi
    local c
    for c in \
        "$HOME/.steam/steam/steamapps/common/SteamVR" \
        "$HOME/.local/share/Steam/steamapps/common/SteamVR" \
        "$HOME/.steam/debian-installation/steamapps/common/SteamVR" \
        /opt/steamvr
    do
        [ -d "$c" ] && { printf '%s' "$c"; return 0; }
    done
    return 1
}

# SteamVR looks for drivers under bin/<platform><arch>; arm64 Linux builds of
# SteamVR use linuxarm64 (see DroidDeck's docs), everything else linux64.
driver_platform() {
    if [ -n "${ANLAND_VR_DRIVER_PLATFORM:-}" ]; then printf '%s' "$ANLAND_VR_DRIVER_PLATFORM"; return; fi
    case "$(uname -m)" in
        aarch64|arm64) printf 'linuxarm64' ;;
        *)             printf 'linux64' ;;
    esac
}

layer_dir_user()   { printf '%s' "$HOME/.local/share/vulkan/implicit_layer.d"; }
layer_lib_user()   { printf '%s' "$HOME/.local/share/anland-vr"; }
layer_dir_system() { printf '%s' "/usr/share/vulkan/implicit_layer.d"; }
layer_lib_system() { printf '%s' "/usr/local/lib/anland-vr"; }

write_layer_json() { # $1 = json path, $2 = absolute library path
    mkdir -p "$(dirname "$1")"
    cat >"$1" <<EOF
{
    "file_format_version": "1.1.0",
    "layer": {
        "name": "$layer_name",
        "type": "GLOBAL",
        "library_path": "$2",
        "api_version": "1.3.0",
        "implementation_version": "1",
        "description": "anland XR: hide VK_KHR_display so SteamVR composites through a window",
        "functions": {
            "vkNegotiateLoaderLayerInterfaceVersion": "AnlandVr_NegotiateLoaderLayerInterfaceVersion"
        },
        "enable_environment": { "ANLAND_VR_LAYER_ENABLE": "1" },
        "disable_environment": { "ANLAND_VR_LAYER_DISABLE": "1" }
    }
}
EOF
}

cmd_install() {
    local system=0
    for a in "$@"; do [ "$a" = "--system" ] && system=1; done

    [ -f "$build/driver_anland.so" ] || die "no $build/driver_anland.so - run xr/build.sh first"

    local sv
    sv=$(find_steamvr) || die "SteamVR not found; set STEAMVR=/path/to/SteamVR"
    local plat dest
    plat=$(driver_platform)
    dest="$sv/drivers/$driver_name/bin/$plat"
    mkdir -p "$dest"
    install -m 0755 "$build/driver_anland.so" "$dest/driver_anland.so"
    install -m 0644 "$here/driver/driver.vrdrivermanifest" "$sv/drivers/$driver_name/driver.vrdrivermanifest"
    say "driver  -> $sv/drivers/$driver_name (bin/$plat)"

    if [ -f "$build/libVkLayer_anland_vr.so" ]; then
        local ldir llib
        if [ "$system" -eq 1 ]; then ldir=$(layer_dir_system); llib=$(layer_lib_system)
        else ldir=$(layer_dir_user); llib=$(layer_lib_user); fi
        mkdir -p "$llib"
        install -m 0755 "$build/libVkLayer_anland_vr.so" "$llib/libVkLayer_anland_vr.so"
        write_layer_json "$ldir/$layer_name.json" "$llib/libVkLayer_anland_vr.so"
        say "layer   -> $ldir/$layer_name.json"
    else
        warn "no libVkLayer_anland_vr.so built; SteamVR still runs windowed, the layer only covers the case where vrcompositor probes VK_KHR_display anyway"
    fi

    # Third-party drivers only load when SteamVR is told to allow them.
    local vs="$HOME/.steam/steam/config/steamvr.vrsettings"
    if [ -f "$vs" ] && command -v python3 >/dev/null 2>&1; then
        python3 - "$vs" <<'PY' || warn "could not update steamvr.vrsettings"
import json, sys, io
p = sys.argv[1]
try:
    with io.open(p, 'r', encoding='utf-8') as f:
        d = json.load(f)
except Exception:
    d = {}
d.setdefault("steamvr", {})["activateMultipleDrivers"] = True
with io.open(p, 'w', encoding='utf-8') as f:
    json.dump(d, f, indent=3)
    f.write("\n")
PY
        say "settings-> activateMultipleDrivers=true in $vs"
    else
        warn "steamvr.vrsettings not edited; if the driver does not show up, set steamvr.activateMultipleDrivers=true"
    fi
    say "done. start SteamVR with: anland-steamvr start"
}

cmd_uninstall() {
    local sv plat
    sv=$(find_steamvr) || true
    if [ -n "$sv" ]; then
        plat=$(driver_platform)
        rm -rf "$sv/drivers/$driver_name"
        say "driver  removed from $sv/drivers/$driver_name"
    fi
    rm -f "$(layer_dir_user)/$layer_name.json" "$(layer_lib_user)/libVkLayer_anland_vr.so"
    rm -f "$(layer_dir_system)/$layer_name.json" "$(layer_lib_system)/libVkLayer_anland_vr.so" 2>/dev/null || true
    say "layer   removed (both user and system locations, where writable)"
}

cmd_status() {
    say "runtime dir : $RT"
    if [ -f "$RT/anland-xr-display" ]; then
        say "display     :"
        sed 's/^/  /' "$RT/anland-xr-display"
    else
        say "display     : <missing> - is the daemon running with xr_enabled=1?"
    fi
    local pose="$RT/anland-xr-pose"
    if [ -f "$pose" ]; then
        if command -v python3 >/dev/null 2>&1; then
            python3 - "$pose" <<'PY'
import os, struct, sys
p = sys.argv[1]
with open(p, 'rb') as f:
    b = f.read(4096)
seq, magic = struct.unpack_from('<II', b, 0)
if magic != 0x41585031:
    print("pose        : bad magic 0x%08x" % magic)
else:
    sample_ns, period_ns = struct.unpack_from('<QQ', b, 8)
    quat = struct.unpack_from('<4d', b, 24)
    age = 0
    print("pose        : seq=%d quat=(%.3f %.3f %.3f %.3f) period=%dns" % (seq, quat[0], quat[1], quat[2], quat[3], period_ns))
PY
        else
            say "pose        : present ($pose)"
        fi
    else
        say "pose        : <missing> - no XR window is attached yet"
    fi
}

cmd_start() {
    local sv
    sv=$(find_steamvr) || die "SteamVR not found; set STEAMVR=/path/to/SteamVR"
    local plat vrs
    plat=$(driver_platform)
    vrs="$sv/bin/$plat/vrstartup.sh"
    [ -x "$vrs" ] || die "no $vrs"
    [ -f "$HOME/.anlandx-env" ] && . "$HOME/.anlandx-env"

    export STEAMVR="$sv"
    export ANLAND_RUNTIME_DIR="$RT"
    # implicit layer only switches on for this process tree
    export ANLAND_VR_LAYER_ENABLE=1
    [ -f "$RT/anland-xr-display" ] || warn "daemon has not written an XR display config; vrcompositor will present flat until an XR window is created"

    say "starting SteamVR ($plat) with ANLAND_VR_LAYER_ENABLE=1"
    exec "$vrs" "$@"
}

cmd_stop() {
    if command -v vrsh >/dev/null 2>&1; then vrsh -shutdown; return; fi
    pkill -f vrserver >/dev/null 2>&1 && say "asked vrserver to stop" || say "vrserver not running"
}

case "${1:-}" in
    install)  shift; cmd_install "$@" ;;
    uninstall) shift; cmd_uninstall ;;
    status)   cmd_status ;;
    start)    shift; cmd_start "$@" ;;
    stop)     cmd_stop ;;
    ""|-h|--help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
    *) die "unknown command '$1' (install|uninstall|status|start|stop)" ;;
esac
